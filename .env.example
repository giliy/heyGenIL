# Copy to .env (repo root) and fill in what you use.

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=

# Pexels — stock b-roll videos/photos (tools/fetch_stock.py). Free tier 200 req/hr,
# 20k req/mo. Sign up at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — stock photos (tools/fetch_stock.py). 100 req/min. Sign up at
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Freesound — recorded diegetic foley (tools/import_sfx.py freesound). Free account +
# API credential at https://freesound.org/apiv2/apply. Only CC0 sounds are imported.
FREESOUND_API_KEY=

# ---------------------------------------------------------------------------
# YouTube publishing (א–ת letter series) — see docs/publishing-playbook.md
# Populated by tools/youtube_auth.py (one-time OAuth bootstrap). Both live in
# publish/credentials/ (gitignored); only the refresh token + secret path go in .env.
# ---------------------------------------------------------------------------

# Refresh token for the YouTube Data API uploader (set by tools/youtube_auth.py).
YOUTUBE_REFRESH_TOKEN=

# Path to the OAuth client_secret.json (Desktop app), repo-root-relative.
# Default: publish/credentials/youtube_client_secret.json
YOUTUBE_CLIENT_SECRET_PATH=

# Optional: fixed rollout start date (YYYY-MM-DD) for the letter series manifest.
# Default: tomorrow when tools/build_publish_manifest.py runs with no --start.
#PUBLISH_START_DATE=

# ---------------------------------------------------------------------------
# Instagram / Meta publishing (א–ת letter series) — see docs/instagram-setup.md
# Long-lived token (~60 days) + IG Business account ID. Exchange short-lived
# tokens via fb_exchange_token with META_APP_ID + META_APP_SECRET.
# ---------------------------------------------------------------------------

# Long-lived Meta User Access Token (instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement). Expires ~60 days — see skill.
META_ACCESS_TOKEN=

# Numeric Instagram Business account ID (from page's instagram_business_account).
IG_USER_ID=

# Meta App credentials (app dashboard → Settings → Basic). Used only for
# fb_exchange_token to mint long-lived tokens.
META_APP_ID=
META_APP_SECRET=

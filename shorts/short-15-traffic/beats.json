  "physics": {
    "note": "ONE SOURCE OF TRUTH. lib/agents.tsx runs the intelligent-driver model (IDM) and returns every car's position and speed each frame. The composition ONLY draws what the sim returns; the jam cluster, the backward arrow and the stat chip are measured off the sim, never asserted. Same ethos as prob.tsx's seeded Monte Carlo, map.tsx's real Mercator, orbit.tsx's velocity Verlet.",
    "model": {
      "name": "Intelligent Driver Model (Treiber, Hennecke & Helbing 2000)",
      "accel": "a = A * (1 - (v/V)^4 - (s*(v,dv)/gap)^2),  s*(v,dv) = s0 + v*T + v*dv/(2*sqrt(A*B))",
      "params": {
        "A_m_s2": 1.5,
        "B_m_s2": 2.0,
        "V_m_s": 30.0,
        "T_s": 1.5,
        "s0_m": 2.0,
        "car_len_m": 4.5
      }
    },
    "ring": {
      "cars": 22,
      "length_m": 800,
      "note": "closed ring = Sugiyama 2008 setup; there is no merge, no light, no exit"
    },
    "trigger": {
      "car": 0,
      "from_s": 5.0,
      "to_s": 6.2,
      "brake_m_s2": -4.5,
      "note": "ONE car brakes ~1.2 s, dipping ~25 -> ~16 m/s. Nothing else touches the traffic. That tiny tap is the entire cause."
    },
    "emergent": {
      "jam_min_speed_m_s": 16.0,
      "free_speed_m_s": 19.0,
      "backward_travel": "the slowest-car index walks 0 -> 19 -> 15 -> 12 -> 9 -> 6 -> 3 -> 0 ... i.e. UPSTREAM, against the direction of travel. Measured from the sim, not scripted.",
      "wave_not_place": "each car passes through the jam and exits the front; the jam persists while its members change. That is the twist."
    },
    "integrator": {
      "dt_s": 0.05,
      "note": "semi-implicit Euler is fine at this dt for IDM; positions wrap mod ring length"
    },
    "reference": "Sugiyama et al. 2008 — real drivers on a real circular road produced a stop-and-go wave with no bottleneck."
  },

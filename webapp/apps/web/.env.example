# Web app env (localhost). Copy to .env.local.
# Use 127.0.0.1, NOT localhost: localhost resolves to ::1 (IPv6) on Windows and can be
# intercepted by wslrelay -> a Postgres inside WSL, silently hitting the WRONG database.
DATABASE_URL=postgres://shorts:shorts@127.0.0.1:5434/shorts
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000
# Nodemailer/Email provider → MailHog SMTP; no external key needed.
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=shorts@localhost
STORAGE_DIR=C:/source/shorts-with-claude/claude-faceless-shorts-creator/webapp/.storage

# ---- Phase 4 billing (Stripe TEST MODE) ----
STRIPE_SECRET_KEY=sk_test_...              # test-mode secret (from dashboard / stripe login)
STRIPE_WEBHOOK_SECRET=whsec_...            # from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_PRICE_CREATOR=price_...             # creator monthly price id (test)
STRIPE_PRICE_PRO=price_...                 # pro monthly price id (test)
APP_URL=http://localhost:3000
CREDITS_PER_PERIOD=500                     # creator monthly credit grant
FREE_RENDERS_PER_MONTH=10                  # free-tier monthly render quota
AI_IMAGE_VENV=.venv-image312               # python env running tools/gen_image.py

# ---- Phase 5 polish (flags; all OFF by default) ----
SSE_ENABLED=false            # SSE job-progress upgrade (off = polling, default)
PUBLISH_TIKTOK_ENABLED=false # direct-publish stubs behind flags
PUBLISH_YOUTUBE_ENABLED=false
BEAT_SYNC_GRID_BPM=120       # fallback tempo for beatless beds

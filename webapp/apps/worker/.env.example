# Worker env (localhost). Copy to .env.
# Use 127.0.0.1, NOT localhost: localhost resolves to ::1 (IPv6) on Windows and can be
# intercepted by wslrelay -> a Postgres inside WSL, silently hitting the WRONG database.
DATABASE_URL=postgres://shorts:shorts@127.0.0.1:5434/shorts
STORAGE_DIR=C:/source/shorts-with-claude/claude-faceless-shorts-creator/webapp/.storage
PORT=3100

# ---- Phase 4 ----
# python venv that runs tools/gen_image.py (`py -3.12 -m venv .venv-image312` +
# `pip install google-genai pillow`). gen_image.py reads GEMINI_API_KEY from the repo root .env.
AI_IMAGE_VENV=.venv-image312

# ---- Phase 5 ----
BEAT_SYNC_GRID_BPM=120       # fallback tempo for beatless beds
